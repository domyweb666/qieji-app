# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
art-src/

# SwiftUI 版（ios-native/）：Xcode 專案與 Info.plist 由 XcodeGen 產生，不進 repo
ios-native/*.xcodeproj/
ios-native/Qieji/Info.plist
ios-native/QiejiControls/Info.plist
ios-native/QiejiWidgets/Info.plist
# 權限檔（entitlements）也由 XcodeGen 照 project.yml 產生
ios-native/Qieji/Qieji.entitlements
ios-native/QiejiWidgets/QiejiWidgets.entitlements
ios-native/DerivedData/
ios-native/formatted.tgz
ios-native/.limbuild-sandbox/
._*
