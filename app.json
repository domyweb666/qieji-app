{
  "expo": {
    "name": "茄記",
    "slug": "qieji",
    "scheme": "qieji",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF3E7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.domyweb.qieji",
      "appleTeamId": "3ZT74P4WM2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "用 Face ID 打開你上鎖的清單"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#331A40",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PaperWidget",
              "displayName": "茄記",
              "description": "上次那張紙的名字和前幾行",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ],
                "initialLayout": "widgets/PaperWidget.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E7",
          "dark": {
            "backgroundColor": "#211A27"
          }
        }
      ],
      "./plugins/withICloudFolderName",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerIdentifier": "iCloud.org.domyweb.qieji",
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@bacons/apple-targets",
      "expo-iap",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "用 Face ID 打開你上鎖的清單"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d02dc6a2-0a03-4d33-8f89-a443a841b626"
      }
    }
  }
}
